{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darktian1977.github.io/sipah/attestations/schemas/case-result-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "case_fingerprint_sha256",
    "outcome",
    "error_code",
    "fixture_only"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "case_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
    "case_fingerprint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "outcome": {"enum": ["PASS", "FAIL", "INVALID"]},
    "error_code": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[A-Z0-9_:-]{1,128}$"}
      ]
    },
    "fixture_only": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {"properties": {"outcome": {"const": "PASS"}}, "required": ["outcome"]},
      "then": {"properties": {"error_code": {"type": "null"}}}
    },
    {
      "if": {"properties": {"outcome": {"enum": ["FAIL", "INVALID"]}}, "required": ["outcome"]},
      "then": {"properties": {"error_code": {"type": "string", "pattern": "^[A-Z0-9_:-]{1,128}$"}}}
    }
  ]
}
