{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_tree_sha256",
    "build_recipe_sha256",
    "dependency_lock_sha256",
    "toolchain_sha256",
    "target_os",
    "target_arch"
  ],
  "properties": {
    "source_tree_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "build_recipe_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dependency_lock_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "toolchain_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "target_os": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "target_arch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "$id": "https://darktian1977.github.io/sipah/attestations/schemas/fase0-tool-build-params-v1.schema.json"
}
