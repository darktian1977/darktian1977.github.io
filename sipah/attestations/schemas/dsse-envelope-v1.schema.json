{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darktian1977.github.io/sipah/attestations/schemas/dsse-envelope-v1.schema.json",
  "type": "object",
  "required": [
    "payload",
    "payloadType",
    "signatures"
  ],
  "properties": {
    "payload": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2800000
    },
    "payloadType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "sig"
        ],
        "properties": {
          "keyid": {
            "type": "string",
            "maxLength": 256
          },
          "sig": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
