{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darktian1977.github.io/sipah/attestations/schemas/corpus-preflight-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "case_count",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "const": "PASS"
    },
    "case_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "case_fingerprint_sha256"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,256}$"
          },
          "case_fingerprint_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
