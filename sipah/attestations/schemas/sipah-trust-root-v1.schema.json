                  "ANCHOR_AUTHORITY",
                  "RUN_AUTHORITY",
                  "AUDITOR_PRIMARY",
                  "AUDITOR_SECONDARY",
                  "RESULT_AUTHORITY",
                  "LEDGER_AUTHORITY",
                  "HOLDOUT_CUSTODIAN"
                ]
              }
            },
            "must_differ_from_candidate_builders": {
              "type": "boolean"
