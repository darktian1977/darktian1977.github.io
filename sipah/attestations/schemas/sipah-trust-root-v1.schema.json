          "type": "object",
          "additionalProperties": false,
          "required": [
            "keyids",
            "min_distinct_keys",
            "min_distinct_principals",
            "min_distinct_custodies",
            "must_differ_from_roles",
            "must_differ_from_candidate_builders"
          ],
          "properties": {
            "keyids": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "min_distinct_keys": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            },
            "min_distinct_principals": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
