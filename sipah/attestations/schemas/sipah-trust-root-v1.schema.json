        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "status": {
            "enum": [
              "ACTIVE",
              "REVOKED"
            ]
          }
        }
      }
    },
    "builders": {
      "type": "object",
      "maxProperties": 128,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "principal_id",
          "status"
