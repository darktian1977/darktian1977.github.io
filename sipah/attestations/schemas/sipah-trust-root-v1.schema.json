        "RUN_AUTHORITY",
        "AUDITOR_PRIMARY",
        "AUDITOR_SECONDARY",
        "RESULT_AUTHORITY",
        "LEDGER_AUTHORITY",
        "HOLDOUT_CUSTODIAN"
