{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darktian1977.github.io/sipah/attestations/schemas/fase0-report-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._:-]{1,128}$"
      }
    }
  }
}
